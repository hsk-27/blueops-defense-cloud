# BlueOps Linux Auditd Telemetry Rules
# Buffer size & Failure mode
-b 8192
-f 1

# Monitor Identity & Authentication files
-w /etc/passwd -p wa -k identity_modification
-w /etc/shadow -p wa -k identity_modification
-w /etc/group -p wa -k identity_modification
-w /etc/gshadow -p wa -k identity_modification
-w /etc/security/opasswd -p wa -k identity_modification

# Monitor Sudo & Privilege Escalation configuration
-w /etc/sudoers -p wa -k priv_escalation_config
-w /etc/sudoers.d/ -p wa -k priv_escalation_config

# Monitor Cron & Scheduled Persistence
-w /etc/cron.allow -p wa -k cron_tamper
-w /etc/cron.deny -p wa -k cron_tamper
-w /etc/cron.d/ -p wa -k cron_tamper
-w /etc/cron.daily/ -p wa -k cron_tamper
-w /etc/cron.hourly/ -p wa -k cron_tamper
-w /etc/cron.monthly/ -p wa -k cron_tamper
-w /etc/cron.weekly/ -p wa -k cron_tamper
-w /etc/crontab -p wa -k cron_tamper
-w /var/spool/cron/ -p wa -k cron_tamper

# Monitor Systemd Service Persistence
-w /etc/systemd/system/ -p wa -k service_creation
-w /usr/lib/systemd/system/ -p wa -k service_creation

# Audit Subsystem Tampering
-w /etc/audit/ -p wa -k audit_tamper
-w /etc/audit/auditd.conf -p wa -k audit_tamper
-w /etc/audit/audit.rules -p wa -k audit_tamper
-w /sbin/auditctl -p x -k audit_tamper
-w /sbin/auditd -p x -k audit_tamper

# Process Execution for Privileged Commands
-a always,exit -F arch=b64 -S execve -F euid=0 -k privileged_execution
