# BlueOps NIDS Lab Signatures for Detection Verification
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"BLUEOPS-D001 Repeated SSH Connection Attempt"; flow:to_server; flags:S; threshold:type both, track by_src, count 5, seconds 30; classtype:attempted-recon; sid:9000001; rev:1;)
alert dns $HOME_NET any -> any any (msg:"BLUEOPS-D015 DNS Query to Known Malicious Test Domain evil-corp.blueops.lab"; dns.query; content:"evil-corp.blueops.lab"; nocase; classtype:bad-unknown; sid:9000002; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"BLUEOPS-D015 HTTP Request to Malicious IOC Path /payload.exe"; http.uri; content:"/payload.exe"; classtype:trojan-activity; sid:9000003; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444 (msg:"BLUEOPS-D014 Suspicious Outbound Connection to Metasploit Default Port 4444"; flow:to_server; classtype:trojan-activity; sid:9000004; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 1337 (msg:"BLUEOPS-D014 Suspicious Outbound Connection to High Port 1337"; flow:to_server; classtype:policy-violation; sid:9000005; rev:1;)
