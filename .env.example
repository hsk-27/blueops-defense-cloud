# ==============================================================================
# BlueOps Defense Cloud - Environment Configuration Template (Lab / Demo Default)
# NOTICE: Copy to .env and replace placeholder secrets with high-entropy CSPRNG
# values before running with SPRING_PROFILES_ACTIVE=prod. NEVER commit .env.
# ==============================================================================

# --- PostgreSQL Operational Database ---
POSTGRES_DB=blueops_db
POSTGRES_USER=blueops_user
POSTGRES_PASSWORD=replace_with_strong_postgres_password

# --- OpenSearch Security Analytics Engine (Single-Node Lab) ---
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
OPENSEARCH_INITIAL_ADMIN_PASSWORD=BlueOpsAdminPass123!@#
OPENSEARCH_DASHBOARDS_PORT=5601

# --- Spring Boot Backend API ---
# Use 'dev' for embedded H2 without Docker; use 'prod' only with strong secrets below
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/blueops_db
SPRING_DATASOURCE_USERNAME=blueops_user
SPRING_DATASOURCE_PASSWORD=replace_with_strong_postgres_password

# JWT Authentication (prod profile requires >= 32 chars & non-default secret)
JWT_SECRET=replace_with_csprng_256bit_jwt_secret_key_for_prod
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# Telemetry Collector Authentication (Fluent Bit -> /api/v1/telemetry/ingest)
BLUEOPS_INGEST_API_KEY=replace_with_csprng_fluentbit_ingest_key

# Demo Seed Toggle (keep false for clean operational start)
BLUEOPS_DEMO_SEED_FINDINGS=false

# OpenSearch Integration
BLUEOPS_OPENSEARCH_ENABLED=false
BLUEOPS_OPENSEARCH_URI=http://localhost:9200
BLUEOPS_OPENSEARCH_USERNAME=admin
BLUEOPS_OPENSEARCH_PASSWORD=BlueOpsAdminPass123!@#
BLUEOPS_OPENSEARCH_SYNC_INTERVAL_MS=10000

# Shared Response Agent Contract (must match between backend and Python agent)
# HOST & AI SAFETY GUARD: Keep hypothetical/simulation mode locked on laptop hosts.
# Do NOT change these settings unless running safely in an isolated non-laptop VM
# or using a verified workaround that cannot execute OS/firewall/account mutations.
RESPONSE_AGENT_URL=http://localhost:5000
RESPONSE_AGENT_SECRET=replace_with_csprng_256bit_hmac_secret_for_prod
RESPONSE_AGENT_SIMULATION_MODE=true
EXECUTION_MODE=SIMULATION
BLUEOPS_ALLOW_LIVE_EXECUTION=false
BLUEOPS_ALLOW_LIVE_HOST_DISRUPTION=false

# --- React SOC Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
PORT=3000

# --- Response Agent Container Port ---
RESPONSE_AGENT_PORT=5000
RESPONSE_AGENT_ALLOWED_ACTIONS=DISABLE_USER,BLOCK_IP,ISOLATE_HOST,COLLECT_EVIDENCE,RESTORE_IP,ENABLE_USER,RECONNECT_HOST
