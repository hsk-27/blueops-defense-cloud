# ==============================================================================
# BlueOps Enterprise SOC Platform - Environment Configuration Template
# NOTE: Copy this file to .env and customize secrets before running services.
# NEVER commit .env to source control.
# ==============================================================================

# --- PostgreSQL Operational Database ---
POSTGRES_DB=blueops_db
POSTGRES_USER=blueops_user
POSTGRES_PASSWORD=blueops_secure_password_replace_in_prod
POSTGRES_PORT=5432

# --- OpenSearch Security Analytics Engine ---
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
OPENSEARCH_INITIAL_ADMIN_PASSWORD=BlueOpsAdminPass123!@#
OPENSEARCH_DASHBOARDS_PORT=5601

# --- Spring Boot Backend API ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/blueops_db
SPRING_DATASOURCE_USERNAME=blueops_user
SPRING_DATASOURCE_PASSWORD=blueops_secure_password_replace_in_prod

# JWT Authentication (HMAC-SHA256 secret >= 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# OpenSearch Integration
BLUEOPS_OPENSEARCH_URI=http://localhost:9200
BLUEOPS_OPENSEARCH_USERNAME=admin
BLUEOPS_OPENSEARCH_PASSWORD=BlueOpsAdminPass123!@#
BLUEOPS_OPENSEARCH_SYNC_INTERVAL_MS=10000

# Response Agent Integration & HMAC Signing
BLUEOPS_RESPONSE_AGENT_URL=http://localhost:5000
BLUEOPS_RESPONSE_AGENT_HMAC_SECRET=b7c938d10b7f43a99e1d8847e923832c3f59194e432c7e436814041b65b16130

# --- React SOC Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
PORT=3000

# --- Response Agent (Lab Host / VM) ---
RESPONSE_AGENT_PORT=5000
RESPONSE_AGENT_SECRET=b7c938d10b7f43a99e1d8847e923832c3f59194e432c7e436814041b65b16130
RESPONSE_AGENT_ALLOWED_ACTIONS=DISABLE_USER,BLOCK_IP,ISOLATE_HOST,COLLECT_EVIDENCE,RESTORE_IP,ENABLE_USER
RESPONSE_AGENT_SIMULATION_MODE=true
