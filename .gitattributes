# BlueOps Git Attributes Configuration
# Ensure consistent cross-platform line endings across Windows, Linux, and macOS

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit LF for code, markup, and config files
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.conf text eol=lf
*.rules text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.env* text eol=lf
Dockerfile* text eol=lf

# Windows scripts must preserve CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.jar binary
*.war binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.tar binary
*.gz binary
*.zip binary
*.exe binary
*.dll binary
*.sys binary
